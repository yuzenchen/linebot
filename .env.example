# 對外 port（Pi 上 80/443/3000-3002/3100/8080/8088 已被占用）
PORT=8090
# SQLite 與匯出檔位置（容器內由 compose 固定為 /data）
DATA_DIR=./data
# 日誌等級：fatal / error / warn / info / debug / trace / silent
LOG_LEVEL=info

# LINE Messaging API channel secret（必填）
LINE_CHANNEL_SECRET=
# LINE 長期 channel access token（必填）
LINE_CHANNEL_ACCESS_TOKEN=

# Anthropic API key；留空時分類器改用規則式
ANTHROPIC_API_KEY=
# 分類用模型
CLASSIFIER_MODEL=claude-opus-5-5

# 服務狀態檢查網址（回 JSON，正常 200、資料庫斷線 503）
HEALTH_CHECK_URL=https://petsnack-backend.onrender.com/health
# 狀態檢查逾時（毫秒），逾時重試一次後才判定異常
HEALTH_CHECK_TIMEOUT_MS=8000
# 狀態檢查結果快取時間（毫秒）
HEALTH_CACHE_MS=30000
# 回覆期限（毫秒），超過則先回「已收到」再 push
REPLY_DEADLINE_MS=10000
# 每位使用者帶入分類的最近訊息數
CONTEXT_MESSAGES=6

# 管理員 LINE userId；留空時管理通知只寫 log
ADMIN_LINE_USER_ID=
# Grok（Cursor Automations webhook）網址；留空時不轉送，service_question 直接交人工
GROK_WEBHOOK_URL=
# Cursor Automations 的 Bearer token（可含或不含「Bearer 」前綴）
GROK_WEBHOOK_SECRET=
# 本服務對外可連的網址（cloudflared 或 https://linebot.<domain>，結尾不加斜線）；設定 GROK_WEBHOOK_URL 時必填
PUBLIC_BASE_URL=
# Cursor agent 回呼 /grok/callback 時放在 x-linebot-token 的共用密鑰；設定 GROK_WEBHOOK_URL 時必填
GROK_CALLBACK_TOKEN=
# Grok 任務等待 done 回呼的上限（毫秒），逾時改交人工，預設 15 分鐘
GROK_TASK_TIMEOUT_MS=900000

# 時區
TZ=Asia/Taipei

# --- 管理端（BOT_PROFILE=admin）---
# 管理端容器用 .env.admin（複製本檔、改 BOT_PROFILE=admin、填管理端 channel 的 LINE 金鑰）
# bot 角色：enduser（客戶端，預設）或 admin（內部管理端）
BOT_PROFILE=enduser
# 管理端白名單：逗號分隔的 LINE userId；BOT_PROFILE=admin 時必填，不在名單者只會收到拒絕文案
ADMIN_USER_IDS=
# pet eshop 後端 API 根網址（結尾不加斜線）
ESHOP_API_BASE=https://petsnack-backend.onrender.com/api/v1
# bot 專用 admin 帳號（只做 GET 查詢）；BOT_PROFILE=admin 時必填
ESHOP_BOT_USERNAME=
ESHOP_BOT_PASSWORD=
# 管理端對話用模型（tool use）；BOT_PROFILE=admin 時 ANTHROPIC_API_KEY 必填，無規則式退路
ADMIN_MODEL=claude-opus-5-5
# 單次對話最多的工具呼叫輪數
ADMIN_MAX_TOOL_ROUNDS=4
# 兩個容器共用的內部通知密鑰（客戶端 → 管理端 /internal/notify 的 x-internal-token）
INTERNAL_NOTIFY_TOKEN=
# 客戶端把管理通知送到管理端的網址（同一 docker network，例如 http://linebot-admin:8090/internal/notify）；留空時維持直接 push ADMIN_LINE_USER_ID
ADMIN_NOTIFY_URL=
